{
  "manifest_version": 3,
  "name": "GhostGram",
  "version": "1.0.0",
  "description": "GhostGram - ferramenta para encontrar e deixar de seguir não seguidores no Instagram",
  "permissions": ["storage", "cookies", "activeTab", "scripting"],
  "host_permissions": ["https://www.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["bundle.js", "content-main.js", "floating-panel-app.js", "src/**/*.js"],
      "matches": ["https://www.instagram.com/*"]
    }
  ]
}
