{
  "name": "ghostgram-extension",
  "version": "1.0.0",
  "description": "GhostGram - Chrome extension for Instagram unfollowers",
  "type": "module",
  "scripts": {
    "icons": "tsx scripts/generate-icons-simple.ts",
    "icons:png": "tsx scripts/generate-icons.ts",
    "icons:convert": "tsx scripts/convert-icons-to-png.ts",
    "icons:sharp": "tsx scripts/generate-icons-sharp.ts",
    "dev": "vite",
    "build": "vite build",
    "build:zip": "tsx scripts/build.ts",
    "build:legacy": "tsx scripts/build-simple.ts",
    "build:minified": "tsx scripts/build-simple.ts && tsx scripts/obfuscate.ts",
    "build:obfuscated": "tsx scripts/build-simple.ts && tsx scripts/obfuscate.ts --obfuscate",
    "clean": "node -e \"import('fs').then(fs => { const path = './build'; if (fs.existsSync(path)) fs.rmSync(path, {recursive: true}); console.log('Build directory cleaned'); })\"",
    "copy-assets": "node -e \"import fs from 'fs'; import path from 'path'; const assets = ['manifest.json','popup.html','popup.css','options.html','styles.css','history.html']; const dirs = ['icons']; if(!fs.existsSync('build'))fs.mkdirSync('build'); assets.forEach(f=>{if(fs.existsSync(f))fs.copyFileSync(f,'build/'+f)}); function cpDir(s,d){if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).forEach(f=>{const sp=path.join(s,f),dp=path.join(d,f);fs.statSync(sp).isDirectory()?cpDir(sp,dp):fs.copyFileSync(sp,dp)})} dirs.forEach(d=>cpDir(d,'build/'+d)); console.log('Assets copied to build/')\"",
    "compile": "npm run copy-assets && tsc --project tsconfig.build.json",
    "compile:watch": "npm run copy-assets && tsc --project tsconfig.build.json --watch",
    "dev:ts": "npm run copy-assets && tsc --project tsconfig.build.json --watch",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration",
    "test:performance": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/performance",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/e2e",
    "test:snapshot": "node --experimental-vm-modules node_modules/jest/bin/jest.js --updateSnapshot tests/unit/domain"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.3.0",
    "@fontsource/noto-sans": "^5.2.10",
    "@jest/globals": "^29.7.0",
    "@types/chrome": "^0.0.268",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "archiver": "^7.0.1",
    "javascript-obfuscator": "^5.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "puppeteer": "^24.15.0",
    "sharp": "^0.34.5",
    "terser": "^5.46.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.3",
    "vite": "^7.3.0",
    "vite-plugin-static-copy": "^3.1.4"
  }
}
