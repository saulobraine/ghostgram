{
  "name": "ghostgram-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GhostGram - Monorepo for Extension, Mobile App, and API",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:app": "pnpm --filter @ghostgram/app dev",
    "dev:app:web": "pnpm --filter @ghostgram/app start --web --port 8081",
    "dev:app:android": "pnpm --filter @ghostgram/app android",
    "dev:app:ios": "pnpm --filter @ghostgram/app ios",
    "dev:api": "pnpm --filter @ghostgram/api dev",
    "dev:api:debug": "pnpm --filter @ghostgram/api start:debug",
    "dev:api:prod": "pnpm --filter @ghostgram/api start:prod",
    "dev:extension": "pnpm --filter @ghostgram/extension dev",
    "build:extension": "pnpm --filter @ghostgram/extension build",
    "dev:desktop": "pnpm --filter @ghostgram/desktop dev",
    "start:desktop": "pnpm --filter @ghostgram/desktop start",
    "build:desktop": "pnpm --filter @ghostgram/desktop build",
    "test:desktop": "pnpm --filter @ghostgram/desktop test",
    "desktop:loop": "tsx scripts/run-desktop-phases.ts",
    "dev:fullstack": "concurrently -n api,app -c green,cyan \"pnpm run dev:api\" \"pnpm run dev:app\"",
    "dev:all": "concurrently -n api,app,ext -c green,cyan,yellow \"pnpm run dev:api\" \"pnpm run dev:app\" \"pnpm run dev:extension\"",
    "prisma:generate": "pnpm --filter @ghostgram/api prisma:generate",
    "prisma:migrate": "pnpm --filter @ghostgram/api prisma:migrate",
    "prisma:studio": "pnpm --filter @ghostgram/api prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "turbo": "^2.0.0",
    "typescript": "^5.4.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
