{
  "manifest_version": 3,
  "name": "GhostGram",
  "version": "1.0.0",
  "description": "GhostGram - ferramenta para encontrar e deixar de seguir não seguidores no Instagram",
  "permissions": ["storage"],
  "host_permissions": ["*://*.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "history.html",
        "history.js",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "src/**/*.js"
      ],
      "matches": ["*://*.instagram.com/*"]
    }
  ]
}
