{
  "name": "@ghostgram/desktop",
  "version": "0.1.0",
  "main": "out/main.js",
  "scripts": {
    "start": "tsc && electron .",
    "dev": "tsc && electron .",
    "build": "tsc && electron-builder",
    "tsc": "tsc",
    "lint": "eslint ."
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.ghostgram.desktop",
    "productName": "GhostGram",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "../app/dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
