{
  "name": "@ghostgram/desktop",
  "version": "0.1.0",
  "description": "GhostGram Desktop - Aplicativo nativo para análise de seguidores e gestão de whitelist no Instagram",
  "author": "GhostGram Team <contact@ghostgram.app>",
  "main": "out/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "dev:electron": "tsc -p tsconfig.main.json && electron .",
    "dev": "concurrently -k \"pnpm run dev:renderer\" \"wait-on tcp:5173 && pnpm run dev:electron\"",
    "start": "electron .",
    "build": "pnpm run build:renderer && pnpm run build:main",
    "pack": "pnpm run build && electron-builder --dir -c.npmRebuild=false",
    "dist": "pnpm run build && electron-builder -c.npmRebuild=false",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ghostgram/shared": "workspace:*",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ghostgram.desktop",
    "productName": "GhostGram",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dir",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "dir",
      "icon": "assets/icon.png"
    }
  }
}
